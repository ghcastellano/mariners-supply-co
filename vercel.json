{
  "regions": [
    "gru1"
  ],
  "build": {
    "env": {
      "NEXT_PUBLIC_SUPABASE_URL": "https://auth.marinerssupplyco.com"
    }
  },
  "crons": [
    {
      "path": "/api/cron/lineup",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/ptax",
      "schedule": "30 14 * * 1-5"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 9 * * *"
    }
  ]
}
